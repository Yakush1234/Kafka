# Kafka broker exposed by docker-compose.yml
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# Synchronous client
KAFKA_TOPIC=study.messages
KAFKA_CONSUMER_GROUP=study-consumers

# Asynchronous client
KAFKA_ASYNC_TOPIC=study.async.messages
KAFKA_ASYNC_CONSUMER_GROUP=study-async-consumers

# Consumer behavior
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_POLL_TIMEOUT_SECONDS=1.0

# Producer behavior
KAFKA_MESSAGE_DELAY_SECONDS=0.1

# Python logging level: DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
